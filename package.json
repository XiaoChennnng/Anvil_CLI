{
  "name": "anvil",
  "version": "0.1.0-alpha",
  "description": "AI-driven CLI programming assistant — Forge Code in the Terminal",
  "private": true,
  "bin": {
    "anvil": "./bin/anvil.js"
  },
  "scripts": {
    "start": "node --title Anvil bin/anvil.js",
    "install-global": "node scripts/install.js",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.js'"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@hurdlegroup/robotjs": "^0.12.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.0",
    "cli-progress": "^3.12.0",
    "commander": "^13.0.0",
    "cosmiconfig": "^9.0.0",
    "glob": "^13.0.6",
    "https-proxy-agent": "^7.0.0",
    "iconv-lite": "^0.7.2",
    "ink": "^7.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "inquirer": "^12.0.0",
    "marked": "^18.0.5",
    "marked-terminal": "^7.3.0",
    "minimatch": "^10.2.5",
    "openai": "^6.43.0",
    "ora": "^8.0.0",
    "react": "^19.2.5",
    "screenshot-desktop": "^1.15.4",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.0.0"
  }
}
